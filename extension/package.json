{
  "name": "nattee-grader",
  "displayName": "ICE Nattee Grader",
  "description": "NatteeGrader (Chula 2190101) in VS Code: problem statements, test cases, run, submit and see your progress",
  "version": "0.4.0",
  "publisher": "potosua7",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#2b3a67",
    "theme": "dark"
  },
  "categories": [
    "Education",
    "Testing",
    "Other"
  ],
  "keywords": [
    "nattee",
    "nattee grader",
    "grader",
    "2190101",
    "chula",
    "chulalongkorn",
    "ICE",
    "cafe grader",
    "test cases",
    "python"
  ],
  "homepage": "https://github.com/PoTOsuA7/ICE-grader-vscode#readme",
  "bugs": {
    "url": "https://github.com/PoTOsuA7/ICE-grader-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nattee",
          "title": "ICE Nattee Grader",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "views": {
      "nattee": [
        {
          "id": "nattee.problems",
          "name": "Problems"
        },
        {
          "id": "nattee.results",
          "name": "Test Results",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nattee.problems",
        "contents": "Sign in to load your problems.\n[Sign in](command:nattee.login)",
        "when": "!nattee.loggedIn"
      }
    ],
    "commands": [
      {
        "command": "nattee.login",
        "title": "Nattee: Sign In"
      },
      {
        "command": "nattee.logout",
        "title": "Nattee: Sign Out"
      },
      {
        "command": "nattee.refresh",
        "title": "Nattee: Refresh Problems",
        "icon": "$(refresh)"
      },
      {
        "command": "nattee.clearCache",
        "title": "Nattee: Clear Cache (re-download statements and tests)"
      },
      {
        "command": "nattee.downloadAll",
        "title": "Nattee: Download All for Offline",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nattee.exportAll",
        "title": "Nattee: Download All Statements and My Solutions"
      },
      {
        "command": "nattee.copyStatement",
        "title": "Nattee: Copy Statement Text",
        "icon": "$(copy)"
      },
      {
        "command": "nattee.saveStatement",
        "title": "Nattee: Save Statement As...",
        "icon": "$(save-as)"
      },
      {
        "command": "nattee.openProblem",
        "title": "Nattee: Open Statement",
        "icon": "$(book)"
      },
      {
        "command": "nattee.createSolution",
        "title": "Nattee: Create Solution File",
        "icon": "$(new-file)"
      },
      {
        "command": "nattee.linkFile",
        "title": "Nattee: Link Current File to Problem"
      },
      {
        "command": "nattee.runTests",
        "title": "Nattee: Run Tests",
        "icon": "$(play)"
      },
      {
        "command": "nattee.showStatement",
        "title": "Nattee: Show Statement for Current File"
      },
      {
        "command": "nattee.submit",
        "title": "Nattee: Submit to Grader",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "nattee.runOneTest",
        "title": "Nattee: Run One Test or Custom Input"
      },
      {
        "command": "nattee.runInTerminal",
        "title": "Nattee: Run in Terminal (type the input yourself)",
        "icon": "$(terminal)"
      },
      {
        "command": "nattee.startMockExam",
        "title": "Nattee: Start Mock Exam",
        "icon": "$(watch)"
      },
      {
        "command": "nattee.handInMockExam",
        "title": "Nattee: Hand In Mock Exam",
        "icon": "$(check)"
      },
      {
        "command": "nattee.explainFailure",
        "title": "Nattee: Explain Test Failure (AI)",
        "icon": "$(sparkle)"
      },
      {
        "command": "nattee.setApiKey",
        "title": "Nattee: Set Gemini API Key"
      },
      {
        "command": "nattee.clearApiKey",
        "title": "Nattee: Clear Gemini API Key"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nattee.refresh",
          "when": "view == nattee.problems",
          "group": "navigation"
        },
        {
          "command": "nattee.downloadAll",
          "when": "view == nattee.problems && nattee.loggedIn",
          "group": "navigation"
        },
        {
          "command": "nattee.startMockExam",
          "when": "view == nattee.problems && nattee.loggedIn && !nattee.mockExam",
          "group": "navigation"
        },
        {
          "command": "nattee.handInMockExam",
          "when": "view == nattee.problems && nattee.mockExam",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nattee.createSolution",
          "when": "viewItem == problem",
          "group": "inline"
        },
        {
          "command": "nattee.openProblem",
          "when": "viewItem == problem",
          "group": "inline"
        },
        {
          "command": "nattee.createSolution",
          "when": "viewItem == problem"
        }
      ],
      "editor/title": [
        {
          "command": "nattee.copyStatement",
          "when": "activeWebviewPanelId == 'natteeStatement' && !nattee.mockExam",
          "group": "navigation"
        },
        {
          "command": "nattee.saveStatement",
          "when": "activeWebviewPanelId == 'natteeStatement'",
          "group": "navigation"
        },
        {
          "command": "nattee.runTests",
          "when": "nattee.activeFileLinked && !nattee.mockExam",
          "group": "navigation"
        },
        {
          "command": "nattee.runInTerminal",
          "when": "nattee.activeFileLinked",
          "group": "navigation"
        },
        {
          "command": "nattee.submit",
          "when": "nattee.activeFileLinked && !nattee.mockExam",
          "group": "navigation"
        },
        {
          "command": "nattee.explainFailure",
          "when": "nattee.hasFailure && !nattee.mockExam",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ICE Nattee Grader",
      "properties": {
        "nattee.rootUrl": {
          "type": "string",
          "default": "https://2190101.nattee.net/",
          "description": "Grader site URL (https). Only settable in user settings, so a workspace cannot send your saved password elsewhere; signing in is tied to this address.",
          "scope": "application"
        },
        "nattee.defaultExtension": {
          "type": "string",
          "default": ".py",
          "description": "Extension for new solution files (.py, .cpp, .c)."
        },
        "nattee.organizeByChapter": {
          "type": "boolean",
          "default": true,
          "description": "Put new solution files in a folder per chapter (e.g. 05_List/05_List_15.py) instead of the workspace root. An existing file for the problem is reused wherever it is."
        },
        "nattee.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python command used to run .py solutions."
        },
        "nattee.cppCompiler": {
          "type": "string",
          "default": "g++",
          "description": "C++ compiler."
        },
        "nattee.cCompiler": {
          "type": "string",
          "default": "gcc",
          "description": "C compiler."
        },
        "nattee.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the tests automatically every time you save a linked solution file."
        },
        "nattee.timeLimitSeconds": {
          "type": "number",
          "default": 3,
          "description": "Per-test time limit.",
          "minimum": 0.1
        },
        "nattee.geminiModel": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "description": "Gemini model used by 'Explain Test Failure (AI)'. Needs a Gemini API key from aistudio.google.com (Nattee: Set Gemini API Key)."
        },
        "nattee.geminiFallbackModel": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "description": "Gemini model tried if nattee.geminiModel is overloaded (HTTP 503). Leave empty to disable."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PoTOsuA7/ICE-grader-vscode"
  },
  "author": "PoTOsuA7",
  "scripts": {
    "test": "node --test"
  }
}
